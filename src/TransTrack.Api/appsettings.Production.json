{
  // ─────────────────────────────────────────────────────────────────────
  // Almost everything that used to live here now lives in appsettings.json,
  // which is production-correct on its own. That is deliberate: when the
  // real CORS origins and the listening port were only in this file, an API
  // started without ASPNETCORE_ENVIRONMENT=Production quietly fell back to
  // development defaults — the browser blocked every login with no error on
  // the server to explain it, and the port was wrong too.
  //
  // Nothing here is required any more. It layers on top of appsettings.json
  // only when ASPNETCORE_ENVIRONMENT=Production, and only for the keys it
  // actually sets. Put a setting here only when it must differ from the
  // base file; otherwise edit appsettings.json and have one place to look.
  // ─────────────────────────────────────────────────────────────────────

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "TransTrack": "Information"
    }
  }
}
