{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "TransTrack": "Information"
    }
  },
  "Jwt": {
    "Issuer": "TransTrack.Api",
    "Audience": "TransTrack.Web",
    "FullSessionHours": "12"
  },
  "Cors": {
    "AllowedOrigins": [ "https://lorryowner.com", "https://www.lorryowner.com" ]
  },

  // Change this to move vehicle document storage somewhere else (a different
  // drive, a mapped share). Null uses C:\TransTruckWeb\VehicleDocs. This
  // folder must be backed up together with the database.
  "VehicleDocumentDirectory": null,
  "VehicleDocumentMaxMb": 10
}
