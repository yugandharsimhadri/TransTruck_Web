{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "TransTrack": "Information"
    }
  },
  // The port the Cloudflare Tunnel forwards loapi.lorryowner.com to.
  // deploy\run-api.ps1 sets ASPNETCORE_URLS to the same thing and that takes
  // precedence when present; this is here so the port survives being started
  // any other way — a Windows service, Task Scheduler, or the bare exe — where
  // no script sets that variable and Kestrel would otherwise fall back to
  // :5000 and quietly strand the tunnel.
  //
  // Loopback only: cloudflared runs on the same machine, so nothing else on
  // the LAN reaches the API directly. Use http://0.0.0.0:6041 to serve the LAN
  // as well.
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:6041"
      }
    }
  },
  "Jwt": {
    "Issuer": "TransTrack.Api",
    "Audience": "TransTrack.Web",
    "FullSessionHours": "12"
  },
  "Cors": {
    "AllowedOrigins": [ "https://lorryowner.com", "https://www.lorryowner.com" ]
  },

  // ── Where things are stored on this machine ──────────────────────────
  // Every path below is null by default, meaning "use the built-in location
  // under C:\TransTruckWeb". Set any of them to an absolute path (another
  // drive, a mapped share) and restart the API to move that folder. Moving
  // a path does NOT move existing files — copy them across yourself first,
  // then change the setting.

  // The live database. Default: C:\TransTruckWeb\DB\TransTruckWeb.db
  "DatabasePath": null,

  // Daily backups, plus the pre-upgrade copy taken before any migration.
  // Default: C:\TransTruckWeb\DBBackup
  "BackupDirectory": null,
  "BackupsToKeep": 14,

  // Uploaded vehicle documents. Default: C:\TransTruckWeb\VehicleDocs
  // The database stores only a reference to each file, so this folder must
  // be backed up together with the database — restoring one without the
  // other leaves records pointing at files that are no longer there.
  "VehicleDocumentDirectory": null,
  "VehicleDocumentMaxMb": 10,

  // Application logs. Default: C:\ProgramData\TransTrack\logs (deliberately
  // not under TransTruckWeb — logging has to keep working when the drive
  // holding the database is the thing that failed). Falls back to the temp
  // folder if that location can't be written to.
  "LogDirectory": null,
  "LogDaysToKeep": 30,
  "LogFileMaxMb": 10
}
