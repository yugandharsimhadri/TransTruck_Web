{
  // Layered over appsettings.json only when ASPNETCORE_ENVIRONMENT is
  // Development - which `dotnet run` sets via launchSettings.json.

  // The base file binds 6041 for the production server. Local development
  // has always been 5034 (the frontend's .env.local, the UAT harness, the
  // docs all assume it), and a "Urls" key in appsettings.json outranks the
  // launch profile's applicationUrl - so it is restored here rather than
  // by editing the base file.
  "Urls": "http://localhost:5034",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
