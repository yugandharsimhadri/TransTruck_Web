{
  // ─────────────────────────────────────────────────────────────────────
  // One file. Everything the API needs to run is here, and every value is
  // safe to run in production as it stands — there is no second file you
  // have to remember, and no environment variable that has to be set for
  // this to behave correctly.
  //
  // appsettings.Development.json layers on top of this for local work only.
  // Environment variables still override anything here (that is how a cloud
  // host injects its own values), but nothing depends on one being set.
  // ─────────────────────────────────────────────────────────────────────

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      // Information rather than Warning: this is what puts one line per
      // request in the console/log, which is most of what "can I see the
      // API's logs" actually means in practice.
      "Microsoft.AspNetCore": "Information"
    }
  },

  "AllowedHosts": "*",

  // The address Kestrel listens on. ASP.NET Core reads this key natively.
  // Deliberately here rather than in an environment-specific file: the port
  // the Cloudflare Tunnel forwards to is not something that should depend on
  // ASPNETCORE_ENVIRONMENT being set correctly. `dotnet run` still overrides
  // this from launchSettings.json for local work.
  "Urls": "http://localhost:6041",

  // ── Database ─────────────────────────────────────────────────────────
  // REQUIRED. This build runs on PostgreSQL only — it carries a single
  // migration generated against Npgsql, and EF validates the model against
  // it whatever the provider, so it cannot open a SQLite file at all. Left
  // unset, the API refuses to start and says so. (Going back to SQLite
  // means redeploying the build from before the PostgreSQL migration, not
  // clearing this setting.)
  //
  //   "PostgresConnectionString": "Host=localhost;Database=transtruckweb;Username=transtrack_app;Password=your-password"
  //
  // TRANSTRUCKWEB_PG_CONNECTION overrides this when set, for cloud hosts
  // that supply their own credentials.
  "PostgresConnectionString": null,

  // ── Security ─────────────────────────────────────────────────────────
  // CHANGE THIS BEFORE ANY REAL DEPLOYMENT. Every signed-in session's token
  // is signed with it, so it must be a long random value, it must stay the
  // same across restarts (changing it signs everyone out), and it must not
  // be the value published in this repo. Set it here, or supply it as the
  // Jwt__Key environment variable.
  "Jwt": {
    "Key": "dev-only-signing-key-change-before-any-real-deployment-32chars+",
    "Issuer": "TransTrack.Api",
    "Audience": "TransTrack.Web",
    "FullSessionHours": "12"
  },

  // Browser origins allowed to call this API. The production sites are
  // listed here, in the base file, on purpose: when they lived only in
  // appsettings.Production.json, an API started without
  // ASPNETCORE_ENVIRONMENT=Production silently fell back to localhost-only
  // and every real login was blocked by the browser with nothing logged
  // server-side to explain it.
  "Cors": {
    "AllowedOrigins": [
      "https://lorryowner.com",
      "https://www.lorryowner.com",
      "http://localhost:3000"
    ]
  },

  // Serves the Swagger UI at /swagger for testing the API directly.
  // Everything behind it still requires the same authentication.
  "EnableSwagger": true,

  // ── Where things are stored ──────────────────────────────────────────
  // All null means "use the built-in location" (under C:\TransTruckWeb).
  // Set DataRoot alone to move the whole installation; set an individual
  // path to move just that one. Changing a path does not move existing
  // files — copy them across first.
  //
  //   "DataRoot": "E:\\LorryOwner"
  //     -> E:\LorryOwner\DB\TransTruckWeb.db
  //        E:\LorryOwner\DBBackup
  //        E:\LorryOwner\VehicleDocs
  "DataRoot": null,

  // The SQLite database file, and its backups. Both unused by this build —
  // it runs on PostgreSQL only (see PostgresConnectionString above), where
  // backups are pg_dump's job. Kept so a database file restored from before
  // the migration can still be found by the tools that read it.
  "DatabasePath": null,
  "BackupDirectory": null,
  "BackupsToKeep": 14,

  // Uploaded vehicle and driver documents. The database stores only a
  // reference, so this folder must be backed up alongside the database.
  "VehicleDocumentDirectory": null,
  "VehicleDocumentMaxMb": 2.5,

  // Application logs. Default: C:\ProgramData\TransTrack\logs — deliberately
  // not under DataRoot, so logging still works when the drive holding the
  // data is the thing that failed. Readable through /api/health/logs.
  "LogDirectory": null,
  "LogDaysToKeep": 30,
  "LogFileMaxMb": 10,

  // Failed requests are always logged. Set this true to log every request
  // as well, while chasing something specific.
  "LogRequests": false
}
