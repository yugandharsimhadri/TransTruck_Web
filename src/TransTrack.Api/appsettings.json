{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "dev-only-signing-key-change-before-any-real-deployment-32chars+",
    "Issuer": "TransTrack.Api",
    "Audience": "TransTrack.Web",
    "FullSessionHours": "12"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },

  // Storage locations. All null here so a developer machine uses the built-in
  // defaults; production sets them in appsettings.Production.json, which is
  // layered on top of this file per key.
  //
  // DataRoot moves the database, backups and documents together — the usual
  // way to put the whole installation on another drive. The individual paths
  // below override it for one folder each. See appsettings.Production.json
  // for the full explanation.
  "DataRoot": null,
  "DatabasePath": null,
  "BackupDirectory": null,

  // Where uploaded vehicle and driver documents are stored on disk. Back this
  // folder up alongside the database — the database only stores the
  // reference, not the file.
  "VehicleDocumentDirectory": null,
  "VehicleDocumentMaxMb": 2.5
}
