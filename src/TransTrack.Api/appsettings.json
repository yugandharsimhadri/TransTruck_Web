{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "dev-only-signing-key-change-before-any-real-deployment-32chars+",
    "Issuer": "TransTrack.Api",
    "Audience": "TransTrack.Web",
    "FullSessionHours": "12"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },

  // Where uploaded vehicle documents are stored on disk. Leave null to use
  // the default, C:\TransTruckWeb\VehicleDocs. Back this folder up alongside
  // the database — the database only stores the reference, not the file.
  "VehicleDocumentDirectory": null,
  "VehicleDocumentMaxMb": 10
}
